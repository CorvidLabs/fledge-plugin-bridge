# Atlas coverage scope for fledge-plugin-bridge.
#
# The specs govern the Kotlin bridge source (src/main), not the test suite, the
# Gradle build system, the static docs page (served on Pages), or build output.
# Keep those out of the coverage denominator. Root-anchored subset of gitignore.

# Test suite.
src/test/

# Build output.
build/
.gradle/

# Gradle build system, wrapper, and manifests.
gradle/
build.gradle.kts
settings.gradle.kts
gradlew
gradlew.bat

# Static docs page (served on Pages).
docs/

# Build hook.
hooks/

# Vendored / generated / minified.
*.min.*
